# API Keys
NEWSAPI_KEY=4d4e4be81eb342b28974ac7ffd90821d
GNEWS_KEY=

# Database Settings
# Default database path (relative to the project directory)
# DATABASE_PATH=database/news_platform.db

# Caching Configuration
# Time in minutes before checking external APIs again for the same category
CACHE_EXPIRY_MINUTES=15

# AI Model Configuration
BERT_MODEL_NAME=typeform/distilbert-base-uncased-mnli
FAKE_NEWS_MODEL_NAME=mrm8488/bert-tiny-finetuned-fake-news-detection

# Filtering and Confidence Thresholds
MIN_INDUSTRY_CONFIDENCE=0.4
MIN_FAKE_NEWS_CONFIDENCE=0.5

# Network retry configuration
RETRY_COUNT=5
RETRY_BACKOFF_FACTOR=0.5
